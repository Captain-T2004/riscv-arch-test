{
  "$schema": "/opt/riscv/share/sail-riscv/sail_riscv_config_schema.json",
  // Sail reference model configuration for SpacemiT K1 / Banana Pi BPI-F3.
  // Only extensions confirmed by DTS, spec implication, or behavioral inference
  // are enabled. Extensions requiring hardware testing (Za64rs, Za128rs, Zic64b,
  // Ziccamoa/if/clsm/crse, scalar crypto, H) are left disabled.
  "base": {
    "xlen": 64,
    "E": false,
    "writable_misa": false,
    "writable_fiom": true,
    "writable_hpm_counters": {
      "len": 32,
      "value": "0xFFFF_FFF8" // hpmcounter3-31 available; cycle/instret always on
    },
    "scounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    "mcounteren_writable_bits": {
      "len": 32,
      "value": "0xFFFF_FFFF"
    },
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    "stvec": {
      "direct": {
        "supported": true
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    "xtval_nonzero": {
      "illegal_instruction": true,
      "software_breakpoint": true,
      "hardware_breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": true,
      "software_check": true,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "medeleg": {
      // All legally-delegatable exception bits on K1 (full S-mode support).
      "delegatable_bits": {
        "len": 64,
        "value": "0x0000_0000_000c_b3FE"
      }
    },
    "mideleg": {
      // All legally-delegatable interrupt bits on K1 (full S-mode support).
      "delegatable_bits": {
        "len": "xlen",
        "value": "0x0000_0000_0000_2222"
      }
    },
    "privileged_isa_version": "Privileged_ISA_1_13",
    "mstatus": {
      "fs_legal_states": "ExtContext_FourState",
      "vs_legal_states": "ExtContext_FourState"
    }
  },
  "memory": {
    // Measured on real K1 hardware: pmpaddr0 implements bits 37:0 (38 bits), not 54.
    "physaddr_bits": 40,
    "pmp": {
      // Measured on real K1 hardware via OpenSBI's boot-time PMP granularity probe.
      "grain": 10,
      "count": 64,
      "usable_count": 32,
      "tor_supported": true,
      // NA4 is architecturally unavailable once grain > 0 (RISC-V priv spec 3.7.2).
      "na4_supported": false,
      "napot_supported": true
    },
    "misaligned": {
      "exceptions": {
        // K1 supports scalar misaligned loads/stores in hardware.
        "load_store": {
          "None": null
        },
        // Unverified either way (see bpif3-rva22s64.yaml VECTOR_LS_MISALIGNED_LEGAL).
        "vector": {
          "Some": "AccessFault"
        },
        "lrsc": "AlignmentException",
        "amo": {
          "Some": "AlignmentException"
        }
      },
      "default_allowed_within_exp": 0,
      "byte_by_byte": false,
      "order_decreasing": false
    },
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    // K1 physical memory layout (Sail model — aligned to Task 2 ACT runner layout):
    //   Null-guard:      0x00000000 - 0x00000FFF (unmapped; address 0 access fault)
    //   DRAM:            0x00001000 - 0x7FFFFFFF (DTB at 0x1000; runner firmware
    //                     0x04000000, tohost 0x04100000, test ELFs 0x04200000,
    //                     pack 0x0C200000)
    //   Gap:             0x80000000 - 0xCFFFFFFF (unmapped)
    //   Peripherals:     0xD0000000 - 0xFFFFFFFF (UART, PLIC, CLINT)
    // The null-guard is intentional: RVMODEL_ACCESS_FAULT_ADDRESS=0x0 (matching
    // every other DUT config in this repo) relies on it for instruction/data
    // access fault tests (MCAUSE=1).
    "regions": [
      // DRAM: 0x1000-0x7FFFFFFF (DTB at 0x1000; 0x0-0xFFF is null-guard)
      {
        "base": {
          "len": 64,
          "value": "0x00001000"
        },
        "size": {
          "len": 64,
          "value": "0x7FFFF000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "None": null
            },
            "vector": {
              "Some": "AccessFault"
            },
            "amo": "AccessFault"
          },
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "atomic_support": "AMOArithmetic",
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          "supports_pte_read": true,
          "supports_pte_write": true
        },
        "include_in_device_tree": true
      },
      // K1 SoC peripheral MMIO: 0xD0000000-0xFFFFFFFF
      // UART0 at 0xD4017000, PLIC at 0xE0000000, CLINT at 0xE4000000.
      {
        "base": {
          "len": 64,
          "value": "0xD0000000"
        },
        "size": {
          "len": 64,
          "value": "0x30000000" // 0xD0000000 - 0xFFFFFFFF
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": {
              "None": null
            },
            "vector": {
              "Some": "AccessFault"
            },
            "amo": "AccessFault"
          },
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "atomic_support": "AMONone",
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      }
    ]
  },
  "platform": {
    "vendorid": 0, // placeholder — read from K1 hardware via csrr mvendorid
    "archid": 0, // placeholder — read from K1 hardware via csrr marchid
    "impid": 0, // placeholder — read from K1 hardware via csrr mimpid
    "hartid": 0,
    "cache_block_size_exp": 6, // 64-byte cache blocks (assumed; Zic64b unverified)
    "reservation": {
      "reservation_set_size_exp": 3,
      "require_exact_reservation_addr": false,
      "invalidate_on_same_hart_store": false
    },
    "clint": {
      // K1 CLINT (spacemit,k1-clint) at 0xE4000000.
      // MSIP: 0xE4000000, MTIME: 0xE400BFF8, MTIMECMP: 0xE4004000.
      "supported": true,
      "base": 3825205248,
      "size": 65536
    },
    "simple_interrupt_generator": {
      "supported": true,
      "base": 4026531840
    },
    "clock_frequency": 1600000000, // K1 runs at 1.6GHz nominal
    "instructions_per_tick": 1,
    "wfi_is_nop": false,
    "wfi_available_to_user_mode": false,
    "max_time_to_wait": 200
  },
  "extensions": {
    "Zama16b": {
      "supported": false
    },
    "M": {
      "supported": true
    },
    "A": {
      "supported": true
    },
    "F": {
      "supported": true,
      // K1 updates mstatus.FS precisely on each FP instruction that modifies fflags.
      "fflags_dirty_policy": "Fflags_Dirty_Precise"
    },
    "D": {
      "supported": true
    },
    "V": {
      // K1: VLEN=256, ELEN=64 (confirmed by SpacemiT hardware documentation)
      "support_level": "Full",
      "vlen_exp": 8, // 2^8 = 256 bits
      "elen_exp": 6, // 2^6 = 64 bits
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill",
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 6,
      "vstart": {
        "zero_required": {
          "arith": true,
          "scalar_move": true
        }
      }
    },
    "B": {
      "supported": true
    },
    "S": {
      "supported": true
    },
    "U": {
      "supported": true
    },
    // Zic64b: not in DTS, not documented. Disabled until ACT testing on hardware confirms it.
    "Zic64b": {
      "supported": false
    },
    "Zicbom": {
      "supported": true
    },
    "Zicbop": {
      "supported": true
    },
    "Zicboz": {
      "supported": true
    },
    // Memory model extensions: never in DTS; require ACT hardware testing to verify.
    "Ziccamoa": {
      "supported": false
    },
    "Ziccif": {
      "supported": false
    },
    "Zicclsm": {
      "supported": false
    },
    "Ziccrse": {
      "supported": false
    },
    "Zicond": {
      "supported": true
    },
    "Zicntr": {
      "supported": true
    },
    "Zicsr": {
      "supported": true
    },
    "Zifencei": {
      "supported": true
    },
    "Zihintpause": {
      "supported": true
    },
    "Zihpm": {
      "supported": true
    },
    "Zaamo": {
      "supported": true
    },
    "Zalrsc": {
      "supported": true
    },
    "Zfa": {
      "supported": false
    },
    "Zfh": {
      "supported": false
    },
    "Zfhmin": {
      "supported": false
    },
    "Zfinx": {
      "supported": false
    },
    "Zdinx": {
      "supported": false
    },
    "Zca": {
      "supported": true
    },
    "Zcf": {
      "supported": false
    },
    "Zcd": {
      "supported": true
    },
    "Zcb": {
      "supported": false
    },
    "Zba": {
      "supported": true
    },
    "Zbb": {
      "supported": true
    },
    "Zbs": {
      "supported": true
    },
    "Zbc": {
      "supported": true
    },
    // Scalar crypto: entirely absent from K1 DTS. All disabled.
    "Zbkb": {
      "supported": false
    },
    "Zbkc": {
      "supported": false
    },
    "Zbkx": {
      "supported": false
    },
    "Zknd": {
      "supported": false
    },
    "Zkne": {
      "supported": false
    },
    "Zknh": {
      "supported": false
    },
    "Zkr": {
      "supported": false,
      "sseed_reset_value": false,
      "useed_reset_value": false,
      "sseed_read_only_zero": false,
      "useed_read_only_zero": false
    },
    "Zksed": {
      "supported": false
    },
    "Zksh": {
      "supported": false
    },
    "Zkt": {
      "supported": false
    },
    "Zhinx": {
      "supported": false
    },
    "Zhinxmin": {
      "supported": false
    },
    "Zvfh": {
      "supported": false
    },
    "Zvfhmin": {
      "supported": false
    },
    "Zvkt": {
      "supported": false
    },
    // Supervisor extensions confirmed by DTS
    "Sscofpmf": {
      "supported": true
    },
    // Sscounterenw: not in DTS. Requires ACT testing to verify.
    "Sscounterenw": {
      "supported": false
    },
    // Ssccptr: not in DTS. Requires ACT testing.
    "Ssccptr": {
      "supported": false
    },
    "Sstc": {
      "supported": true
    },
    // Sstvala, Sstvecd: not in DTS. Requires ACT testing.
    "Sstvala": {
      "supported": false
    },
    "Svade": {
      "supported": false
    }, // unverified — requires ACT testing on silicon
    "Svadu": {
      "supported": false
    },
    "Svinval": {
      "supported": false
    },
    "Svnapot": {
      "supported": false
    },
    "Svbare": {
      "supported": true,
      "sfence_vma_illegal_if_svbare_only": true
    },
    "Sv32": {
      "supported": false
    },
    "Sv39": {
      "supported": true
    },
    "Sv48": {
      "supported": false
    },
    "Sv57": {
      "supported": false
    }, // not supported on K1
    "Svpbmt": {
      "supported": true
    },
    // Stateen: Ssstateen unknown, Smstateen unknown.
    "Stateen": {
      "Smstateen": {
        "supported": false
      },
      "Ssstateen": {
        "supported": false
      },
      "C_readonly_zero": true,
      "SE0_readonly_zero": true
    },
    // H extension absent from K1 DTS and all SpacemiT public documentation.
    // All Sha sub-extensions depend on H and are therefore also absent.
    "Ssqosid": {
      "supported": false,
      "rcid_length": 1,
      "mcid_length": 1
    },
    // Pointer Masking extensions: not confirmed on K1. Required by schema.
    "Ssnpm": {
      "supported": false,
      "supported_pmlen_7": false,
      "supported_pmlen_16": false
    },
    "Smnpm": {
      "supported": false,
      "supported_pmlen_7": false,
      "supported_pmlen_16": false
    },
    "Smmpm": {
      "supported": false,
      "supported_pmlen_7": false,
      "supported_pmlen_16": false
    },
    // Additional required fields per Sail JSON schema. Not confirmed on K1.
    "Smcntrpmf": {
      "supported": false
    },
    "Svrsw60t59b": {
      "supported": false
    },
    "Svvptc": {
      "supported": false
    },
    "Zabha": {
      "supported": false
    },
    // Atomic extensions not confirmed on K1 hardware
    "Zacas": {
      "supported": false
    },
    "Zawrs": {
      "supported": false,
      "nto": {
        "is_nop": false
      },
      "sto": {
        "is_nop": false
      }
    },
    // Compressed extensions not in K1 DTS
    "Zcmop": {
      "supported": false
    },
    // FP extensions not confirmed on K1
    "Zfbfmin": {
      "supported": false
    },
    // Integer extensions not in K1 DTS
    "Zibi": {
      "supported": false
    },
    "Ziccamoc": {
      "supported": false
    },
    "Zicfilp": {
      "supported": false
    },
    "Zicfiss": {
      "supported": false
    },
    "Zihintntl": {
      "supported": false
    },
    "Zimop": {
      "supported": false
    },
    "Zmmul": {
      "supported": false
    },
    // Vector extensions not confirmed on K1
    "Zvabd": {
      "supported": false
    },
    "Zvbb": {
